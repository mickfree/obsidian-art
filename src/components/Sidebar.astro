---
interface NavigationItem {
	label: string;
	href: string;
}

interface Props {
	navigation?: NavigationItem[];
	contactEmail?: string;
}

const {
	navigation = [
		{ label: 'Principal', href: '/' },
		{ label: 'Colecciones', href: '/collections' },
		{ label: 'Materiales', href: '/materials' },
		{ label: 'Info', href: '/info' },
	],
	contactEmail = 'hello@obsidian.art',
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
	const normalizedHref = href.replace(/\/$/, '') || '/';
	return normalizedHref === '/'
		? currentPath === '/'
		: currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<button
	class="menu-toggle"
	type="button"
	aria-label="Abrir menú"
	aria-controls="site-sidebar"
	aria-expanded="false"
>
	<i class="ti ti-menu-2" aria-hidden="true"></i>
</button>

<button class="sidebar-backdrop" type="button" aria-label="Cerrar menú" tabindex="-1"></button>

<aside class="sidebar" id="site-sidebar" aria-label="Navegación principal" aria-hidden="true">
	<nav class="site-nav">
		<ul>
			{navigation.map((item) => (
				<li>
					<a class:list={['nav-link', isCurrent(item.href) && 'is-current']} href={item.href}>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="sidebar-meta">
		<div>
			<p class="meta-title">Contacto</p>
			<a href={`mailto:${contactEmail}`}>Copiar email</a>
		</div>

		<div>
			<p class="meta-title">Social</p>
			<p class="social-links">
				<a href="#instagram">Instagram</a>
				<span>/</span>
				<a href="#behance">Behance</a>
			</p>
		</div>
	</div>
</aside>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const sidebar = document.querySelector<HTMLElement>('.sidebar');
	const backdrop = document.querySelector<HTMLButtonElement>('.sidebar-backdrop');

	const setMenuState = (isOpen: boolean) => {
		document.body.classList.toggle('menu-is-open', isOpen);
		menuToggle?.setAttribute('aria-expanded', String(isOpen));
		menuToggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
		sidebar?.setAttribute('aria-hidden', String(!isOpen));
		backdrop?.setAttribute('tabindex', isOpen ? '0' : '-1');

		const icon = menuToggle?.querySelector('i');
		icon?.classList.toggle('ti-menu-2', !isOpen);
		icon?.classList.toggle('ti-x', isOpen);
	};

	menuToggle?.addEventListener('click', () => {
		setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
	});

	backdrop?.addEventListener('click', () => setMenuState(false));
	sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
			setMenuState(false);
			menuToggle.focus();
		}
	});
</script>

<style>
	.menu-toggle {
		position: fixed;
		z-index: 40;
		top: 20px;
		left: 20px;
		display: grid;
		width: 44px;
		height: 44px;
		padding: 0;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: var(--color-paper-soft);
		box-shadow: 0 8px 28px rgb(0 0 0 / 12%);
		font-size: 24px;
		color: var(--color-ink);
		cursor: pointer;
		transition: color 200ms, transform 200ms, background-color 200ms;
	}

	.menu-toggle:hover,
	.menu-toggle:focus-visible {
		background: var(--color-paper);
		color: var(--color-accent);
		transform: scale(1.06);
	}

	.sidebar-backdrop {
		position: fixed;
		z-index: 20;
		inset: 0;
		border: 0;
		background: rgb(9 11 10 / 48%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 350ms ease;
	}

	.sidebar {
		position: fixed;
		z-index: 30;
		inset: 0 auto 0 0;
		display: flex;
		width: min(86vw, 360px);
		box-sizing: border-box;
		flex-direction: column;
		padding: 96px 32px 42px;
		background: var(--color-paper-soft);
		box-shadow: 18px 0 55px rgb(0 0 0 / 15%);
		transform: translateX(-105%);
		visibility: hidden;
		transition: transform 450ms cubic-bezier(.22, 1, .36, 1), visibility 450ms;
	}

	:global(.menu-is-open) { overflow: hidden; }
	:global(.menu-is-open) .sidebar { transform: translateX(0); visibility: visible; }
	:global(.menu-is-open) .sidebar-backdrop { opacity: 1; pointer-events: auto; }
	.site-nav { margin-top: 32px; }
	.site-nav ul { display: block; margin: 0; padding: 0; list-style: none; }
	.nav-link {
		display: inline-block;
		padding-block: 4px;
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 1.45;
		color: var(--color-ink-muted);
		text-decoration: none;
		text-transform: uppercase;
		transition: color 200ms, transform 200ms;
	}
	.nav-link.is-current { font-weight: 500; color: var(--color-ink); }
	.nav-link:hover,
	.nav-link:focus-visible { transform: translateX(6px); color: var(--color-accent); }

	.sidebar-meta { display: grid; gap: 34px; margin-top: auto; font-size: 14px; color: var(--color-ink-subtle); }
	.sidebar-meta a { color: inherit; text-decoration: none; }
	.sidebar-meta a:hover,
	.sidebar-meta a:focus-visible { color: var(--color-accent); }
	.meta-title { margin: 0 0 8px; font-size: 16px; color: var(--color-ink); }
	.social-links { display: flex; gap: 9px; margin: 0; }

	@media (min-width: 681px) {
		.menu-toggle { top: 28px; left: 28px; }
		.sidebar { width: 360px; padding: 110px 48px 48px; }
		.sidebar-backdrop { display: none; }
		:global(.menu-is-open) { overflow-y: auto; }
		.site-nav { margin-top: 64px; }
		.nav-link { font-size: clamp(20px, 1.4vw, 28px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-toggle,
		.sidebar,
		.sidebar-backdrop,
		.nav-link { transition: none; }
	}
</style>
