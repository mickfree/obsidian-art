---
export interface Fact {
	label: string;
	value: string;
}

export interface TextSection {
	title: string;
	paragraphs: string[];
}

export interface MaterialUse {
	title: string;
	description: string;
}

export interface Props {
	id: string;
	title: string;
	eyebrow: string;
	lead: string;
	image: string;
	imageAlt: string;
	facts: Fact[];
	lore: TextSection;
	usesTitle: string;
	uses: MaterialUse[];
	curiosity: TextSection;
	reversed?: boolean;
	priority?: boolean;
	mainHeading?: boolean;
}

const {
	id,
	title,
	eyebrow,
	lead,
	image,
	imageAlt,
	facts,
	lore,
	usesTitle,
	uses,
	curiosity,
	reversed = false,
	priority = false,
	mainHeading = false,
} = Astro.props;

const Heading = mainHeading ? 'h1' : 'h2';
---

<section class:list={['material-layout', { 'material-layout--reversed': reversed }]} aria-labelledby={`${id}-title`}>
	<div class="material-visual">
		<img
			src={image}
			alt={imageAlt}
			width="1200"
			height="800"
			loading={priority ? 'eager' : 'lazy'}
			fetchpriority={priority ? 'high' : 'auto'}
		/>
	</div>

	<div class="material-info">
		<p class="eyebrow">{eyebrow}</p>
		<Heading class="material-title" id={`${id}-title`}>{title}</Heading>
		<p class="lead">{lead}</p>

		<div class="facts" aria-label={`Datos sobre ${title}`}>
			{facts.map((fact) => <div><span>{fact.label}</span><p>{fact.value}</p></div>)}
		</div>

		<section class="text-block" aria-labelledby={`${id}-lore-title`}>
			<h3 id={`${id}-lore-title`}>{lore.title}</h3>
			{lore.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</section>

		<section class="uses" aria-labelledby={`${id}-uses-title`}>
			<h3 id={`${id}-uses-title`}>{usesTitle}</h3>
			<ul>
				{uses.map((use) => <li><strong>{use.title}</strong><span>{use.description}</span></li>)}
			</ul>
		</section>

		<section class="text-block" aria-labelledby={`${id}-curiosity-title`}>
			<h3 id={`${id}-curiosity-title`}>{curiosity.title}</h3>
			{curiosity.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</section>
	</div>
</section>

<style>
	.material-layout {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
		gap: clamp(28px, 4vw, 72px);
		max-width: 1600px;
		margin: clamp(30px, 5vh, 70px) auto 80px;
	}

	.material-layout--reversed { grid-template-columns: minmax(300px, 1fr) minmax(0, 2fr); }
	.material-layout--reversed .material-info { grid-column: 1; grid-row: 1; }
	.material-layout--reversed .material-visual { grid-column: 2; grid-row: 1; }
	.material-visual { position: sticky; top: 24px; align-self: start; }
	.material-visual img { display: block; width: 100%; max-height: 800px; object-fit: cover; }
	.material-info { padding: clamp(20px, 3vw, 48px) 0; }
	.eyebrow { margin: 0; font-size: 9px; letter-spacing: .16em; color: var(--color-ink-faint); text-transform: uppercase; }

	.material-title {
		margin: 24px 0 28px;
		font-family: var(--font-display);
		font-size: clamp(54px, 6vw, 96px);
		font-weight: 300;
		line-height: .86;
		letter-spacing: -.06em;
	}

	.lead { margin: 0; font-family: var(--font-display); font-size: clamp(20px, 2vw, 30px); font-weight: 300; line-height: 1.25; color: var(--color-ink-muted); }
	.facts { margin-top: 54px; border-top: 1px solid var(--color-divider-soft); }
	.facts > div { display: grid; grid-template-columns: 90px 1fr; gap: 18px; padding: 15px 0; border-bottom: 1px solid var(--color-divider-soft); }
	.facts span { font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }
	.facts p, .text-block p { margin: 0; font-size: 13px; line-height: 1.65; color: var(--color-ink-muted); }
	.text-block, .uses { margin-top: 76px; }
	.material-info h3 { margin: 18px 0 28px; font-family: var(--font-display); font-size: clamp(28px, 2.5vw, 42px); font-weight: 300; line-height: 1; letter-spacing: -.04em; }
	.text-block p + p { margin-top: 18px; }
	.uses ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-divider-soft); }
	.uses li { display: flex; flex-direction: column; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--color-divider-soft); }
	.uses strong { font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
	.uses li span { font-size: 13px; color: var(--color-ink-muted); }

	@media (max-width: 760px) {
		.material-layout, .material-layout--reversed { grid-template-columns: 1fr; margin-top: 20px; }
		.material-layout--reversed .material-info,
		.material-layout--reversed .material-visual { grid-column: auto; grid-row: auto; }
		.material-visual { position: relative; top: auto; }
		.material-visual img { height: min(70svh, 640px); }
		.material-info { padding-top: 24px; }
		.material-title { margin-top: 18px; }
	}
</style>
