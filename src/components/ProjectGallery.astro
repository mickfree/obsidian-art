---
interface GalleryImage {
	src: string;
	alt: string;
}

interface Props {
	title: string;
	gallery: GalleryImage[];
}

const { title, gallery } = Astro.props;
const collectionLayouts = [
	'col-start-2 col-span-4 aspect-[1.3] max-[760px]:col-auto',
	'col-start-7 col-span-6 mt-[13vw] aspect-[2.15] max-[760px]:col-span-2 max-[760px]:mt-0',
	'col-start-1 col-span-7 mt-[4vw] aspect-[1.9] max-[760px]:col-span-2 max-[760px]:mt-0',
	'col-start-8 col-span-4 mt-[15vw] aspect-[1.55] max-[760px]:col-auto max-[760px]:mt-0',
];

const imageClass = 'block h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(.2,.75,.2,1)] group-hover:scale-[1.025] motion-reduce:transition-none';
---

<main class="overflow-hidden">
	<header class="min-h-[clamp(250px,32vw,440px)] px-[clamp(24px,4vw,78px)] pt-[clamp(22px,2.2vw,40px)] max-[760px]:min-h-[250px]">
		<a class="text-[10px] tracking-[.16em] text-[#77746e] uppercase no-underline" href="/projects">← Todos los proyectos</a>
		<h1 class="mt-[clamp(54px,5vw,90px)] text-center font-display text-[clamp(52px,10.4vw,196px)] leading-[.82] font-medium tracking-[-.075em] whitespace-nowrap text-[#cfcecb] max-[760px]:mt-[62px] max-[760px]:text-[clamp(43px,14vw,80px)] max-[760px]:leading-[.88] max-[760px]:whitespace-normal">
			{title}
		</h1>
	</header>

	<section class="grid grid-cols-[15.5vw_21vw_minmax(0,1fr)] items-end gap-[clamp(14px,1.25vw,24px)] px-[clamp(24px,3.7vw,70px)] pb-[clamp(100px,11vw,210px)] max-[760px]:grid-cols-2 max-[760px]:items-start max-[760px]:pb-[100px]" aria-label={`Galería ${title}`}>
		<figure class="group m-0 aspect-[.78] overflow-hidden bg-[#ecebe8]">
			<img class={imageClass} src={gallery[0].src} alt={gallery[0].alt} />
		</figure>
		<figure class="group m-0 ml-[clamp(35px,7vw,132px)] aspect-[.72] overflow-hidden bg-[#ecebe8] max-[760px]:mt-[60px] max-[760px]:ml-0">
			<img class={imageClass} src={gallery[1].src} alt={gallery[1].alt} />
		</figure>
		<figure class="group m-0 aspect-[1.7] overflow-hidden bg-[#ecebe8] max-[760px]:col-span-2">
			<img class={imageClass} src={gallery[2].src} alt={gallery[2].alt} />
		</figure>
	</section>

	<section class="grid grid-cols-12 gap-[clamp(18px,2.6vw,50px)] px-[clamp(24px,5.2vw,100px)] pb-[clamp(90px,10vw,190px)] max-[760px]:grid-cols-2 max-[760px]:pb-[100px]" aria-label={`Más vistas de ${title}`}>
		{gallery.slice(3).map((image, index) => (
			<figure class:list={['group m-0 overflow-hidden bg-[#ecebe8]', collectionLayouts[index]]}>
				<img class={imageClass} src={image.src} alt={image.alt} loading="lazy" />
			</figure>
		))}
	</section>
</main>
