---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MaterialSection from "@/components/MaterialSection.astro";
import Sidebar from "@/components/Sidebar.astro";

const obsidian = {
	title: 'Obsidiana',
	eyebrow: 'Vidrio volcánico · Protección · Verdad',
	lead: 'Nacida cuando la lava se enfría antes de poder formar cristales, la obsidiana conserva la intensidad del fuego y la quietud de la tierra.',
	image: '/images/materials/obsidian/obsidian.webp',
	imageAlt: 'Obsidiana negra en estado natural',
	facts: [
		{ label: 'Origen', value: 'Roca ígnea; vidrio volcánico natural rico en sílice.' },
		{ label: 'Aspecto', value: 'Negro profundo, caoba, dorado, plateado, nevado o arcoíris.' },
		{ label: 'Elemento', value: 'Fuego y tierra, transformación y arraigo.' },
	],
	lore: {
		title: 'El espejo protector',
		paragraphs: [
			'En la tradición esotérica, la obsidiana negra se considera un escudo frente a energías densas. Se asocia con el chakra raíz y se utiliza para fortalecer los límites personales, recuperar el centro y mantener los pies en la tierra.',
			'También es llamada “espejo del alma”: se cree que revela patrones ocultos, ayuda a enfrentar la sombra y acompaña procesos de cambio, verdad y cierre.',
		],
	},
	usesTitle: 'Cómo acompañarte',
	uses: [
		{ title: 'Como amuleto', description: 'Protección y límites energéticos.' },
		{ title: 'En meditación', description: 'Introspección, claridad y liberación.' },
		{ title: 'En el hogar', description: 'Cerca de la entrada, como guardiana simbólica.' },
	],
	curiosity: {
		title: 'Más afilada de lo que parece',
		paragraphs: ['Al romperse produce bordes extraordinariamente finos. Por eso distintas culturas la convirtieron en puntas, cuchillos y espejos rituales pulidos.'],
	},
};

// Añade aquí cada material. La posición se alterna automáticamente según el índice.
const materials = [
	{ id: 'obsidiana', ...obsidian },
	{ id: 'obsidiana-alternativa', ...obsidian },
];
---

<BaseLayout
	title="Obsidiana — Materiales | Obsidian Art"
	description="Origen, curiosidades y simbolismo protector de la obsidiana, el vidrio volcánico nacido del fuego."
>
	<main class="materials-page">
		<Sidebar />
		<header class="site-header border-b">
			<a class="wordmark" href="/">Obsidian Art</a>
			<p>Materiales</p>
		</header>

		{materials.map((material, index) => (
			<MaterialSection
				{...material}
				reversed={index % 2 === 1}
				priority={index === 0}
				mainHeading={index === 0}
			/>
		))}
	</main>
</BaseLayout>

<style>
	:global(.materials-body) {
		margin: 0;
		background: #f2f0eb;
		font-family: var(--font-sans);
		color: var(--color-ink);
	}

	.materials-page {
		display: flex;
		min-height: 100svh;
		flex-direction: column;
		padding: 4px clamp(20px, 3vw, 58px) 28px;
	}

	.site-header {
		display: grid;
		min-height: 58px;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		font-size: 10px;
		letter-spacing: .16em;
		text-transform: uppercase;
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 15px;
		font-weight: 500;
		letter-spacing: .04em;
		color: inherit;
		text-decoration: none;
	}

	.site-header p { margin: 0; color: #6e6b64; }

	@media (max-width: 760px) {
		.materials-page { padding-inline: 16px; }
		.site-header { grid-template-columns: 1fr auto; }
		.site-header p { display: none; }
	}
</style>
