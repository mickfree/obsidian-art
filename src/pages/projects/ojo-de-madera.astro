---
import '../../styles/global.css';
import ProjectGallery from '../../components/ProjectGallery.astro';

const gallery = [
	{ src: '/images/gallery/ojo_madera_03.webp', alt: 'Pulsera Ojo de Madera vista de frente' },
	{ src: '/images/gallery/ojo_madera_05.webp', alt: 'Detalle de las cuentas y acentos dorados' },
	{ src: '/images/gallery/ojo_madera_01.webp', alt: 'Pulsera Ojo de Madera en perspectiva' },
	{ src: '/images/gallery/ojo_madera_04.webp', alt: 'Vista cenital de la pulsera Ojo de Madera' },
	{ src: '/images/gallery/ojo_madera_06.webp', alt: 'Perfil de las cuentas naturales' },
	{ src: '/images/gallery/ojo_madera_02.webp', alt: 'Pulsera vista desde un ángulo bajo' },
	{ src: '/images/gallery/ojo_madera_07.webp', alt: 'Vista frontal completa de la pulsera' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Ojo de Madera — joyería artesanal en ojo de tigre y detalles dorados." />
		<title>Ojo de Madera — Obsidian Art</title>
	</head>
	<body class="m-0 bg-[#f5f4f1] font-sans text-[#24231f]">
		<ProjectGallery title="OJO DE MADERA" gallery={gallery} />
	</body>
</html>
