---
import '../../styles/global.css';

const gallery = [
	{ src: '/images/gallery2/siete-chacras_03.webp', alt: 'Pulsera Siete Chakras vista de frente' },
	{ src: '/images/gallery2/siete-chacras_05.webp', alt: 'Detalle de las siete piedras de colores' },
	{ src: '/images/gallery2/siete-chacras_01.webp', alt: 'Pulsera Siete Chakras en perspectiva' },
	{ src: '/images/gallery2/siete-chacras_04.webp', alt: 'Vista cenital de la pulsera Siete Chakras' },
	{ src: '/images/gallery2/siete-chacras_06.webp', alt: 'Detalle de las cuentas de piedra volcánica' },
	{ src: '/images/gallery2/siete-chacras_02.webp', alt: 'Pulsera Siete Chakras vista desde un ángulo lateral' },
	{ src: '/images/gallery2/siete-chacras_07.webp', alt: 'Vista frontal completa de la pulsera Siete Chakras' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Siete Chakras — pulsera artesanal de piedra volcánica y minerales naturales." />
		<title>Siete Chakras — Obsidian Art</title>
	</head>
	<body>
		<main>
			<header class="hero">
				<a href="/projects">← Todos los proyectos</a>
				<h1>SIETE CHAKRAS</h1>
			</header>

			<section class="lead-gallery" aria-label="Galería Siete Chakras">
				<figure class="lead-small"><img src={gallery[0].src} alt={gallery[0].alt} /></figure>
				<figure class="lead-detail"><img src={gallery[1].src} alt={gallery[1].alt} /></figure>
				<figure class="lead-wide"><img src={gallery[2].src} alt={gallery[2].alt} /></figure>
			</section>

			<section class="collection" aria-label="Más vistas de Siete Chakras">
				{gallery.slice(3).map((image, index) => (
					<figure class:list={[`item-${index + 1}`]}>
						<img src={image.src} alt={image.alt} loading="lazy" />
					</figure>
				))}
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: #f5f4f1; color: #24231f; font-family: var(--font-sans); }
	main { overflow: hidden; }
	.hero { min-height: clamp(250px, 32vw, 440px); padding: clamp(22px, 2.2vw, 40px) clamp(24px, 4vw, 78px) 0; }
	.hero a { color: #77746e; font-size: 10px; letter-spacing: .16em; text-decoration: none; text-transform: uppercase; }
	h1 { margin: clamp(54px, 5vw, 90px) 0 0; color: #cfcecb; font-family: var(--font-display); font-size: clamp(52px, 10.4vw, 196px); font-weight: 500; letter-spacing: -.075em; line-height: .82; text-align: center; white-space: nowrap; }
	.lead-gallery { display: grid; grid-template-columns: 15.5vw 21vw minmax(0, 1fr); align-items: end; gap: clamp(14px, 1.25vw, 24px); padding: 0 clamp(24px, 3.7vw, 70px) clamp(100px, 11vw, 210px); }
	figure { margin: 0; overflow: hidden; background: #ecebe8; }
	figure img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 900ms cubic-bezier(.2,.75,.2,1); }
	figure:hover img { transform: scale(1.025); }
	.lead-small { aspect-ratio: .78; }
	.lead-detail { aspect-ratio: .72; margin-left: clamp(35px, 7vw, 132px); }
	.lead-wide { aspect-ratio: 1.7; }
	.collection { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(18px, 2.6vw, 50px); padding: 0 clamp(24px, 5.2vw, 100px) clamp(90px, 10vw, 190px); }
	.item-1 { grid-column: 2 / span 4; aspect-ratio: 1.3; }
	.item-2 { grid-column: 7 / -1; margin-top: 13vw; aspect-ratio: 2.15; }
	.item-3 { grid-column: 1 / span 7; margin-top: 4vw; aspect-ratio: 1.9; }
	.item-4 { grid-column: 8 / span 4; margin-top: 15vw; aspect-ratio: 1.55; }
	@media (max-width: 760px) {
		.hero { min-height: 250px; }
		h1 { margin-top: 62px; font-size: clamp(43px, 14vw, 80px); line-height: .88; white-space: normal; }
		.lead-gallery { grid-template-columns: 1fr 1fr; align-items: start; padding-bottom: 100px; }
		.lead-detail { margin: 60px 0 0; }
		.lead-wide { grid-column: 1 / -1; }
		.collection { grid-template-columns: 1fr 1fr; padding-bottom: 100px; }
		.item-1,.item-2,.item-3,.item-4 { grid-column: auto; margin-top: 0; }
		.item-2,.item-3 { grid-column: 1 / -1; }
	}
	@media (prefers-reduced-motion: reduce) { figure img { transition: none; } }
</style>
