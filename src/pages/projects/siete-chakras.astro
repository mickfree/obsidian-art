---
import '../../styles/global.css';
import ProjectGallery from '../../components/ProjectGallery.astro';

const gallery = [
	{ src: '/images/gallery2/siete-chacras_03.webp', alt: 'Pulsera Siete Chakras vista de frente' },
	{ src: '/images/gallery2/siete-chacras_05.webp', alt: 'Detalle de las siete piedras de colores' },
	{ src: '/images/gallery2/siete-chacras_01.webp', alt: 'Pulsera Siete Chakras en perspectiva' },
	{ src: '/images/gallery2/siete-chacras_04.webp', alt: 'Vista cenital de la pulsera Siete Chakras' },
	{ src: '/images/gallery2/siete-chacras_06.webp', alt: 'Detalle de las cuentas de piedra volcánica' },
	{ src: '/images/gallery2/siete-chacras_02.webp', alt: 'Pulsera Siete Chakras vista desde un ángulo lateral' },
	{ src: '/images/gallery2/siete-chacras_07.webp', alt: 'Vista frontal completa de la pulsera Siete Chakras' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Siete Chakras — pulsera artesanal de piedra volcánica y minerales naturales." />
		<title>Siete Chakras — Obsidian Art</title>
	</head>
	<body class="m-0 bg-[#f5f4f1] font-sans text-[#24231f]">
		<ProjectGallery title="SIETE CHAKRAS" gallery={gallery} />
	</body>
</html>
