---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
	{ title: 'Ojo de Madera', type: 'Pulsera · 2026', image: '/images/collections/ojo-de-madera/ojo_madera_04.webp', href: '/collections/ojo-de-madera', real: true },
	{ title: 'Siete Chakras', type: 'Pulsera · 2026', image: '/images/collections/siete-chakras/siete-chacras_04.webp', href: '/collections/siete-chakras', real: true },
	{ title: 'Piedra Nocturna', type: 'Collar · Estudio', image: '/images/collections/piedra-nocturna.png' },
	{ title: 'Sol de Bronce', type: 'Broche · Estudio', image: '/images/collections/sol-de-bronce.png' },
	{ title: 'Humo y Raíz', type: 'Collar · Estudio', image: '/images/collections/humo-y-raiz.png' },
	{ title: 'Ojo de Madera', type: 'Pulsera · 2026', image: '/images/collections/ojo-de-madera/ojo_madera_04.webp', href: '/collections/ojo-de-madera', real: true },
	{ title: 'Siete Chakras', type: 'Pulsera · 2026', image: '/images/collections/siete-chakras/siete-chacras_04.webp', href: '/collections/siete-chakras', real: true },
];
---

<BaseLayout
	title="Proyectos — Obsidian Art"
	description="Catálogo de proyectos y colecciones de Obsidian Art."
	bodyClass="projects-body"
>
		<main class="projects-page">
			<header class="site-header">
				<a class="wordmark" href="/">Obsidian Art</a>
				<p>proyectos</p>
			</header>

			<section class="catalog" aria-label="Catálogo de proyectos">
				{projects.map((project, index) => (
					<article class:list={['project-card', project.real && 'is-current']} tabindex="0">
						<img src={project.image} alt={`Vista previa de ${project.title}`} />
						<div class="card-overlay"></div>
						<div class="card-number">{String(index + 1).padStart(2, '0')}</div>
						<div class="card-content">
							<p>{project.type}</p>
							<h2>{project.title}</h2>
							<span>{project.real ? 'Ver proyecto →' : 'Proyecto de muestra'}</span>
						</div>
						{project.href && <a class="card-link" href={project.href} aria-label={`Ver proyecto ${project.title}`}></a>}
					</article>
				))}
			</section>

			<footer class="page-footer">
				<p>Explora materia, forma y contraste.</p>
				<a href="/">Volver a Gallery</a>
			</footer>
		</main>
</BaseLayout>

<style>
	:global(.projects-body) {
		margin: 0;
		background: #f2f0eb;
		font-family: var(--font-sans);
		color: var(--color-ink);
	}

	.projects-page {
		display: flex;
		min-height: 100svh;
		flex-direction: column;
		padding: 24px clamp(20px, 3vw, 58px) 28px;
	}

	.site-header {
		display: grid;
		min-height: 58px;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		font-size: 10px;
		letter-spacing: .16em;
		text-transform: uppercase;
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 15px;
		font-weight: 500;
		letter-spacing: .04em;
		color: inherit;
		text-decoration: none;
	}

	.site-header p { margin: 0; color: #6e6b64; }
	.site-header span { justify-self: end; color: #8d8981; }

	.catalog {
		display: flex;
		width: 100%;
		max-width: 1450px;
		height: min(61svh, 660px);
		min-height: 440px;
		gap: clamp(7px, .8vw, 15px);
		margin: clamp(35px, 5vh, 70px) auto 34px;
	}

	.project-card {
		position: relative;
		min-width: 0;
		flex: 1;
		overflow: hidden;
		background: #d8d5ce;
		outline: 0;
		transition: flex-grow 650ms cubic-bezier(.2, .7, .2, 1), transform 650ms cubic-bezier(.2, .7, .2, 1), opacity 650ms cubic-bezier(.2, .7, .2, 1);
	}

	.project-card:nth-child(even) { transform: translateY(5%); }
	.project-card:nth-child(3n) { transform: translateY(-2%); }
	.project-card:hover,
	.project-card:focus,
	.project-card:focus-within { flex-grow: 2.7; transform: translateY(-2%); }

	.project-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(.7) grayscale(.35);
		transition: filter 800ms cubic-bezier(.2, .7, .2, 1), transform 800ms cubic-bezier(.2, .7, .2, 1);
	}

	.project-card:hover img,
	.project-card:focus img,
	.project-card:focus-within img { transform: scale(1.035); filter: saturate(1) grayscale(0); }

	.card-overlay {
		position: absolute;
		inset: 0;
		background: rgb(242 240 235 / 50%);
		transition: background-color 500ms;
	}

	.project-card:hover .card-overlay,
	.project-card:focus .card-overlay,
	.project-card:focus-within .card-overlay { background: transparent; }

	.card-number {
		position: absolute;
		top: 14px;
		left: 14px;
		font-size: 9px;
		letter-spacing: .12em;
		color: rgb(255 255 255 / 80%);
	}

	.card-content {
		position: absolute;
		z-index: 2;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 18px;
		transform: translateY(12px);
		color: white;
		opacity: 0;
		transition: opacity 450ms, transform 450ms;
	}

	.card-content::before {
		position: absolute;
		z-index: -1;
		top: -70px;
		right: 0;
		bottom: 0;
		left: 0;
		background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 65%));
		content: '';
	}

	.project-card:hover .card-content,
	.project-card:focus .card-content,
	.project-card:focus-within .card-content { transform: translateY(0); opacity: 1; }
	.card-content p { margin: 0; font-size: 9px; letter-spacing: .13em; text-transform: uppercase; }
	.card-content h2 { margin: 6px 0; font-family: var(--font-display); font-size: clamp(21px, 2vw, 35px); font-weight: 400; line-height: .95; letter-spacing: -.045em; }
	.card-content span { font-size: 9px; letter-spacing: .13em; color: rgb(255 255 255 / 75%); text-transform: uppercase; }
	.card-link { position: absolute; z-index: 3; inset: 0; }

	.catalog:has(.project-card:hover) .project-card:not(:hover),
	.catalog:has(.project-card:focus-within) .project-card:not(:focus-within) { opacity: .62; }

	.page-footer { display: flex; align-items: end; justify-content: space-between; margin-top: auto; padding-top: 24px; }
	.page-footer p { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 3vw, 48px); letter-spacing: -.045em; }
	.page-footer p span { display: block; margin-bottom: 8px; font-family: var(--font-sans); font-size: 9px; letter-spacing: .16em; color: #77736b; text-transform: uppercase; }
	.page-footer a { font-size: 10px; letter-spacing: .14em; color: #5f5c56; text-decoration: none; text-transform: uppercase; }

	@media (max-width: 760px) {
		.projects-page { padding-inline: 16px; }
		.site-header { grid-template-columns: 1fr auto; }
		.site-header p { display: none; }
		.catalog { height: 61svh; min-height: 480px; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; }
		.project-card,
		.project-card:nth-child(even),
		.project-card:nth-child(3n),
		.project-card:hover,
		.project-card:focus,
		.project-card:focus-within { flex: 0 0 46vw; transform: translateY(0); scroll-snap-align: center; }
		.card-overlay { background: rgb(242 240 235 / 18%); }
		.card-content { transform: translateY(0); opacity: 1; }
		.page-footer { display: block; }
		.page-footer a { display: inline-block; margin-top: 24px; }
	}
</style>
