---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
---

<BaseLayout
	title="Gallery — Obsidian Art"
	description="Obsidian Art — archivo de obras, proyectos y exploraciones visuales."
	bodyClass="home-body"
>
		<main class="home-page">
			<Sidebar />

			<div class="page-content">
				<section class="featured-artwork" aria-label="Obra destacada">
					<img
						src="/images/wallpaper/principal_visual.webp"
						alt="Composición abstracta de mármol negro con vetas doradas"
					/>
					<span class="artwork-title">
						Obsidian Art
					</span>
					<div class="artwork-overlay" aria-hidden="true"></div>
				</section>

				<section
					class="gallery-panel"
					id="gallery"
					aria-labelledby="gallery-title"
				>
					<header>
						<a
							href="/collections"
							class="collection-link"
							id="gallery-title"
						>
							Colecciónes
						</a>
					</header>

					<div class="gallery-copy">
						<p>
							Un archivo de formas, materia y contraste. Cada pieza nace de explorar
							lo que aparece cuando la luz toca la oscuridad.
						</p>
						<p class="translation">
							An archive of form, matter and contrast. Select the work to discover
							the story behind its surface.
						</p>
					</div>

					<footer class="gallery-footer">
						<span>Obsidian Art</span>
						<span>Arequipa, PE</span>
					</footer>
				</section>
			</div>
		</main>
</BaseLayout>

<style>
	:global(.home-body) {
		margin: 0;
		background: var(--color-paper);
		font-family: var(--font-sans);
		font-weight: 300;
		color: var(--color-ink);
	}

	.home-page {
		min-height: 100svh;
		background: var(--color-paper);
		overflow-x: clip;
	}

	.page-content {
		display: grid;
		width: 100%;
		min-height: 100svh;
	}

	.collection-link { color: inherit; text-decoration: none; }

	.featured-artwork {
		position: relative;
		min-height: 70svh;
		overflow: hidden;
		background: var(--color-artwork);
	}

	.featured-artwork img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 70svh;
		object-fit: cover;
		object-position: center;
		transition: transform 1200ms cubic-bezier(.2, .7, .2, 1);
	}

	.featured-artwork:hover img { transform: scale(1.025); }

	.artwork-title {
		position: absolute;
		z-index: 10;
		top: 50%;
		left: 0;
		padding: 12px 20px;
		transform: translateY(-50%);
		border-radius: 0;
		background: var(--color-paper);
		font-family: var(--font-display);
		font-size: 36px;
		font-weight: 500;
		letter-spacing: .04em;
		color: var(--color-ink);
		text-transform: uppercase;
	}

	.artwork-overlay {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(180deg, transparent 62%, var(--color-artwork-overlay));
	}

	.gallery-panel {
		position: relative;
		display: flex;
		overflow: hidden;
		flex-direction: column;
		padding: 44px 20px 28px;
		background: var(--color-paper);
	}

	.collection-link {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(56px, 65px, 82px);
		font-weight: 300;
		line-height: .95;
		letter-spacing: -.065em;
	}

	.gallery-copy {
		position: relative;
		z-index: 10;
		max-width: 340px;
		margin-top: 68px;
		padding-left: 20px;
		border-left: 1px solid var(--color-divider);
		font-size: clamp(14px, .84vw, 16px);
		line-height: 1.62;
	}

	.gallery-copy p { margin: 0; }
	.gallery-copy .translation { margin-top: 38px; color: var(--color-ink-faint); }

	.gallery-footer {
		position: relative;
		z-index: 10;
		display: flex;
		justify-content: space-between;
		margin-top: 76px;
		padding-top: 12px;
		border-top: 1px solid var(--color-divider-soft);
		font-size: 11px;
		letter-spacing: .08em;
		color: var(--color-ink-faint);
		text-transform: uppercase;
	}

	@media (min-width: 681px) {
		.featured-artwork,
		.featured-artwork img { min-height: 100svh; }
		.artwork-title { padding: 16px 28px; font-size: 72px; }
		.gallery-panel { padding: 62px 32px 48px; }
		.gallery-panel header { max-width: 560px; }
		.collection-link { font-size: 68px; }
		.gallery-copy { max-width: 560px; margin-top: 72px; }
		.gallery-footer { margin-top: 90px; }
	}

	@media (min-width: 1051px) {
		.page-content { grid-template-columns: minmax(0, 70%) minmax(310px, 1fr); }
		.gallery-panel { min-height: 100svh; padding-top: 30px; padding-bottom: 42px; }
		.gallery-panel header { max-width: none; }
		.gallery-copy { max-width: 340px; margin-top: clamp(150px, 25vh, 260px); }
		.gallery-footer { margin-top: auto; }
	}

	@media (prefers-reduced-motion: reduce) {
		.featured-artwork img { transition: none; }
	}
</style>
