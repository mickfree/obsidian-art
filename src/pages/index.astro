---
import BaseLayout from "@/layouts/BaseLayout.astro";

const navigation = [
	{ label: 'Principal', href: '/' },
	{ label: 'Colecciones', href: '/collections' },
	{ label: 'Materiales', href: '/materials' },
	{ label: 'Info', href: '/info' },
];
---

<BaseLayout
	title="Gallery — Obsidian Art"
	description="Obsidian Art — archivo de obras, proyectos y exploraciones visuales."
	bodyClass="home-body"
>
		<main class="home-page">
			<button
				class="menu-toggle"
				type="button"
				aria-label="Abrir menú"
				aria-controls="site-sidebar"
				aria-expanded="false"
			>
				<i class="ti ti-menu-2" aria-hidden="true"></i>
			</button>

			<button class="sidebar-backdrop" type="button" aria-label="Cerrar menú" tabindex="-1"></button>

			<aside class="sidebar" id="site-sidebar" aria-label="Navegación principal" aria-hidden="true">
				<nav class="site-nav">
					<ul>
						{navigation.map((item, index) => (
							<li>
								<a
									class:list={[
										'nav-link',
										index === 0 && 'is-current',
									]}
									href={item.href}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>

				<div class="sidebar-meta">
					<div>
						<p class="meta-title">Contacto</p>
						<a href="mailto:hello@obsidian.art">
							Copiar email
						</a>
					</div>

					<div>
						<p class="meta-title">Social</p>
						<p class="social-links">
							<a href="#instagram">Instagram</a>
							<span>/</span>
							<a href="#behance">Behance</a>
						</p>
					</div>
				</div>
			</aside>

			<div class="page-content">
				<section class="featured-artwork" aria-label="Obra destacada">
					<img
						src="/images/wallpaper/principal_visual.webp"
						alt="Composición abstracta de mármol negro con vetas doradas"
					/>
					<span class="artwork-title">
						Obsidian Art
					</span>
					<div class="artwork-overlay" aria-hidden="true"></div>
				</section>

				<section
					class="gallery-panel"
					id="gallery"
					aria-labelledby="gallery-title"
				>
					<header>
						<a
							href="/collections"
							class="collection-link"
							id="gallery-title"
						>
							Colecciónes
						</a>
					</header>

					<div class="gallery-copy">
						<p>
							Un archivo de formas, materia y contraste. Cada pieza nace de explorar
							lo que aparece cuando la luz toca la oscuridad.
						</p>
						<p class="translation">
							An archive of form, matter and contrast. Select the work to discover
							the story behind its surface.
						</p>
					</div>

					<footer class="gallery-footer">
						<span>Obsidian Art</span>
						<span>Arequipa, PE</span>
					</footer>
				</section>
			</div>
		</main>
</BaseLayout>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const sidebar = document.querySelector<HTMLElement>('.sidebar');
	const backdrop = document.querySelector<HTMLButtonElement>('.sidebar-backdrop');

	const setMenuState = (isOpen: boolean) => {
		document.body.classList.toggle('menu-is-open', isOpen);
		menuToggle?.setAttribute('aria-expanded', String(isOpen));
		menuToggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
		sidebar?.setAttribute('aria-hidden', String(!isOpen));
		backdrop?.setAttribute('tabindex', isOpen ? '0' : '-1');

		const icon = menuToggle?.querySelector('i');
		icon?.classList.toggle('ti-menu-2', !isOpen);
		icon?.classList.toggle('ti-x', isOpen);
	};

	menuToggle?.addEventListener('click', () => {
		setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
	});

	backdrop?.addEventListener('click', () => setMenuState(false));

	sidebar?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenuState(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
			setMenuState(false);
			menuToggle.focus();
		}
	});
</script>

<style>
	:global(.home-body) {
		margin: 0;
		background: var(--color-paper);
		font-family: var(--font-sans);
		font-weight: 300;
		color: var(--color-ink);
	}

	.home-page {
		min-height: 100svh;
		background: var(--color-paper);
		overflow-x: clip;
	}

	.page-content {
		display: grid;
		width: 100%;
		min-height: 100svh;
		transition: width 450ms cubic-bezier(.22, 1, .36, 1), margin-left 450ms cubic-bezier(.22, 1, .36, 1);
	}

	.menu-toggle {
		position: fixed;
		z-index: 40;
		top: 20px;
		left: 20px;
		display: grid;
		width: 44px;
		height: 44px;
		padding: 0;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: var(--color-paper-soft);
		box-shadow: 0 8px 28px rgb(0 0 0 / 12%);
		font-size: 24px;
		color: var(--color-ink);
		cursor: pointer;
		transition: color 200ms, transform 200ms, background-color 200ms;
	}

	.menu-toggle:hover,
	.menu-toggle:focus-visible {
		background: var(--color-paper);
		color: var(--color-accent);
		transform: scale(1.06);
	}

	.sidebar-backdrop {
		position: fixed;
		z-index: 20;
		inset: 0;
		border: 0;
		background: rgb(9 11 10 / 48%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 350ms ease;
	}

	.sidebar {
		position: fixed;
		z-index: 30;
		inset: 0 auto 0 0;
		display: flex;
		width: min(86vw, 360px);
		flex-direction: column;
		padding: 96px 32px 42px;
		background: var(--color-paper-soft);
		box-shadow: 18px 0 55px rgb(0 0 0 / 15%);
		transform: translateX(-105%);
		visibility: hidden;
		transition: transform 450ms cubic-bezier(.22, 1, .36, 1), visibility 450ms;
	}

	:global(.menu-is-open) { overflow: hidden; }
	:global(.menu-is-open) .sidebar {
		transform: translateX(0);
		visibility: visible;
	}
	:global(.menu-is-open) .sidebar-backdrop {
		opacity: 1;
		pointer-events: auto;
	}

	.site-nav { margin-top: 32px; }
	.site-nav ul { display: block; margin: 0; padding: 0; list-style: none; }

	.nav-link {
		display: inline-block;
		padding-block: 4px;
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 1.45;
		color: var(--color-ink-muted);
		text-transform: uppercase;
		transition: color 200ms, transform 200ms;
	}

	.nav-link,
	.sidebar-meta a,
	.collection-link { color: inherit; text-decoration: none; }
	.nav-link { color: var(--color-ink-muted); }
	.nav-link.is-current { font-weight: 500; color: var(--color-ink); }
	.nav-link:hover,
	.nav-link:focus-visible { transform: translateX(6px); color: var(--color-accent); }

	.sidebar-meta { display: grid; gap: 34px; margin-top: auto; font-size: 14px; color: var(--color-ink-subtle); }
	.meta-title { margin: 0 0 8px; font-size: 16px; color: var(--color-ink); }
	.sidebar-meta a:hover,
	.sidebar-meta a:focus-visible { color: var(--color-accent); }
	.social-links { display: flex; gap: 9px; margin: 0; }

	.featured-artwork {
		position: relative;
		min-height: 70svh;
		overflow: hidden;
		background: var(--color-artwork);
	}

	.featured-artwork img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 70svh;
		object-fit: cover;
		object-position: center;
		transition: transform 1200ms cubic-bezier(.2, .7, .2, 1);
	}

	.featured-artwork:hover img { transform: scale(1.025); }

	.artwork-title {
		position: absolute;
		z-index: 10;
		top: 50%;
		left: 0;
		padding: 12px 20px;
		transform: translateY(-50%);
		border-radius: 0;
		background: var(--color-paper);
		font-family: var(--font-display);
		font-size: 36px;
		font-weight: 500;
		letter-spacing: .04em;
		color: var(--color-ink);
		text-transform: uppercase;
	}

	.artwork-overlay {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(180deg, transparent 62%, var(--color-artwork-overlay));
	}

	.gallery-panel {
		position: relative;
		display: flex;
		overflow: hidden;
		flex-direction: column;
		padding: 44px 20px 28px;
		background: var(--color-paper);
	}

	.collection-link {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(56px, 65px, 82px);
		font-weight: 300;
		line-height: .95;
		letter-spacing: -.065em;
	}

	.gallery-copy {
		position: relative;
		z-index: 10;
		max-width: 340px;
		margin-top: 68px;
		padding-left: 20px;
		border-left: 1px solid var(--color-divider);
		font-size: clamp(14px, .84vw, 16px);
		line-height: 1.62;
	}

	.gallery-copy p { margin: 0; }
	.gallery-copy .translation { margin-top: 38px; color: var(--color-ink-faint); }

	.gallery-footer {
		position: relative;
		z-index: 10;
		display: flex;
		justify-content: space-between;
		margin-top: 76px;
		padding-top: 12px;
		border-top: 1px solid var(--color-divider-soft);
		font-size: 11px;
		letter-spacing: .08em;
		color: var(--color-ink-faint);
		text-transform: uppercase;
	}

	@media (min-width: 681px) {
		.menu-toggle { top: 28px; left: 28px; }
		.sidebar { width: 360px; padding: 110px 48px 48px; }
		.sidebar-backdrop { display: none; }
		:global(.menu-is-open) { overflow-y: auto; }
		:global(.menu-is-open) .page-content {
			width: calc(100% - 360px);
			margin-left: 360px;
		}
		.site-nav { margin-top: 64px; }
		.nav-link { font-size: clamp(20px, 1.4vw, 28px); }
		.featured-artwork,
		.featured-artwork img { min-height: 100svh; }
		.artwork-title { padding: 16px 28px; font-size: 72px; }
		.gallery-panel { padding: 62px 32px 48px; }
		.gallery-panel header { max-width: 560px; }
		.collection-link { font-size: 68px; }
		.gallery-copy { max-width: 560px; margin-top: 72px; }
		.gallery-footer { margin-top: 90px; }
	}

	@media (min-width: 1051px) {
		.page-content { grid-template-columns: minmax(0, 70%) minmax(310px, 1fr); }
		.gallery-panel { min-height: 100svh; padding-top: 30px; padding-bottom: 42px; }
		.gallery-panel header { max-width: none; }
		.gallery-copy { max-width: 340px; margin-top: clamp(150px, 25vh, 260px); }
		.gallery-footer { margin-top: auto; }
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-toggle,
		.sidebar,
		.sidebar-backdrop,
		.page-content,
		.nav-link,
		.featured-artwork img { transition: none; }
	}
</style>
