---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Info — Obsidian Art"
	description="Acerca de Obsidian Art, un archivo digital de joyería, materia y exploraciones visuales."
>
	<main class="info-page">
		<header class="site-header justify-between">
			<a class="wordmark" href="/">Obsidian Art</a>
			<a class="index-link" href="/collections">Ver colecciones</a>
		</header>

		<div class="layout">
			<section class="identity" aria-labelledby="info-title">
				<h1 id="info-title">
					<span>Obsidian</span>
					<span>Art</span>
				</h1>
			</section>

			<div class="content">
				<section class="intro" aria-labelledby="about-title">
					<h2 id="about-title">Un archivo de objetos nacidos entre la luz y la oscuridad.</h2>
					<div class="body-copy">
						<p>
							Obsidian Art es un espacio dedicado a la joyería artesanal y a la exploración
							visual de la materia. Cada pieza parte del encuentro entre minerales, metales,
							texturas y símbolos para crear objetos con carácter propio.
						</p>
						<p>
							Este sitio reúne colecciones, piezas únicas y procesos de estudio. Es una memoria
							digital del trabajo: una forma de observar de cerca sus superficies, conocer las
							historias que las atraviesan y descubrir cómo cada material encuentra su forma.
						</p>
					</div>
				</section>

				<section class="details" aria-labelledby="details-title">
					<h2 id="details-title">Qué encontrarás</h2>
					<dl>
						<div>
							<dt>Proyectos</dt>
							<dd>Colecciones y piezas seleccionadas, documentadas en detalle.</dd>
						</div>
						<div>
							<dt>Materiales</dt>
							<dd>Piedras, metales y procesos que dan identidad a cada objeto.</dd>
						</div>
						<div>
							<dt>Archivo</dt>
							<dd>Una colección en crecimiento de formas, pruebas y hallazgos.</dd>
						</div>
					</dl>
				</section>

				<section class="contact" aria-labelledby="contact-title">
					<div>
						<h2 id="contact-title">Conversemos</h2>
					</div>
					<div class="contact-links">
						<a href="mailto:hello@obsidian.art">hello@obsidian.art</a>
						<a href="https://www.instagram.com/#" target="_blank" rel="noreferrer">Instagram ↗</a>
					</div>
				</section>

				<section class="credits" aria-labelledby="credits-title">
					<h2 id="credits-title">Créditos</h2>
					<div class="credit-row">
						<span>Design</span>
						<a href="https://github.com/mickfree" target="_blank" rel="noreferrer">@mickfree ↗</a>
					</div>
					<div class="credit-row">
						<span>Website</span>
						<a href="https://github.com/mickfree" target="_blank" rel="noreferrer">@mickfree ↗</a>
					</div>
				</section>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.info-page {
		min-height: 100svh;
		padding: 24px clamp(20px, 4.2vw, 80px) 28px;
		background:
			radial-gradient(circle at 13% 18%, rgb(183 96 10 / 7%) 0 1px, transparent 2px),
			var(--color-paper);
	}

	.site-header,
	.page-footer {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		font-size: 10px;
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.site-header { min-height: 44px; }
	.site-header p { margin: 0; color: var(--color-ink-faint); }
	.wordmark { font-family: var(--font-display); font-size: 15px; font-weight: 500; letter-spacing: .04em; }
	.index-link { justify-self: end; }

	.layout {
		display: grid;
		grid-template-columns: minmax(280px, 42%) minmax(420px, 1fr);
		gap: clamp(60px, 9vw, 180px);
		max-width: 1560px;
		margin: clamp(82px, 14vh, 170px) auto 0;
	}

	.identity {
		position: sticky;
		top: 60px;
		display: flex;
		align-self: start;
		min-height: 66vh;
		flex-direction: column;
		justify-content: center;
	}

	.identity-dot {
		position: absolute;
		top: 4%;
		left: 12%;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-ink);
	}

	.identity h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(50px, 6.2vw, 112px);
		font-weight: 300;
		line-height: .86;
		letter-spacing: -.065em;
		text-transform: uppercase;
	}

	.identity h1 span:first-child { display: block; font-weight: 500; }
	.identity h1 span:last-child { display: block; margin-left: 24%; letter-spacing: .12em; }
	.identity > p { margin: 28px 0 0 25%; font-size: 10px; letter-spacing: .16em; color: var(--color-ink-faint); text-transform: uppercase; }

	.content { max-width: 700px; }
	.content section + section { margin-top: clamp(92px, 13vh, 160px); }
	.eyebrow { margin: 0 0 54px; font-size: 9px; letter-spacing: .16em; color: var(--color-ink-faint); text-transform: uppercase; }

	.content h2 {
		max-width: 640px;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(29px, 3vw, 52px);
		font-weight: 300;
		line-height: 1.08;
		letter-spacing: -.045em;
	}

	.body-copy {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(28px, 4vw, 64px);
		margin-top: 72px;
		font-size: 14px;
		line-height: 1.72;
		color: var(--color-ink-muted);
	}

	.body-copy p { margin: 0; }
	.details h2, .contact h2, .credits h2 { font-size: clamp(24px, 2vw, 35px); }
	.details dl { margin: 48px 0 0; }
	.details dl > div, .credit-row { display: grid; grid-template-columns: minmax(110px, .42fr) 1fr; gap: 24px; border-bottom: 1px solid var(--color-divider-soft); padding: 18px 0; }
	.details dt, .credit-row span { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
	.details dd { margin: 0; font-size: 14px; line-height: 1.55; color: var(--color-ink-muted); }

	.contact { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
	.contact .eyebrow { margin-bottom: 36px; }
	.contact-links { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 13px; font-size: 14px; }
	.contact-links a, .credit-row a, .site-header a, .page-footer a { transition: color 180ms ease; }
	.contact-links a:hover, .credit-row a:hover, .site-header a:hover, .page-footer a:hover { color: var(--color-accent); }
	.credits { margin-bottom: clamp(100px, 18vh, 210px); }
	.credits .eyebrow { margin-bottom: 36px; }
	.credits h2 { margin-bottom: 36px; }
	.credit-row a { justify-self: start; }

	.page-footer { border-top: 1px solid var(--color-divider); padding-top: 14px; color: var(--color-ink-faint); }
	.page-footer span:nth-child(2) { justify-self: center; }
	.page-footer a { justify-self: end; color: var(--color-ink); }

	@media (max-width: 820px) {
		.site-header { grid-template-columns: 1fr auto; }
		.site-header p { display: none; }
		.layout { display: block; margin-top: 72px; }
		.identity { position: relative; top: auto; min-height: 56svh; }
		.identity-dot { top: 0; left: 5%; }
		.identity h1 { font-size: clamp(56px, 17vw, 96px); }
		.identity h1 span:last-child { margin-left: 18%; }
		.identity > p { margin-left: 19%; }
		.content { margin-left: clamp(0px, 9vw, 70px); }
	}

	@media (max-width: 560px) {
		.info-page { padding-inline: 18px; }
		.identity { min-height: 52svh; }
		.body-copy { grid-template-columns: 1fr; margin-top: 46px; }
		.content section + section { margin-top: 96px; }
		.eyebrow { margin-bottom: 38px; }
		.contact { grid-template-columns: 1fr; }
		.contact-links { margin-top: 12px; }
		.details dl > div, .credit-row { grid-template-columns: 95px 1fr; gap: 15px; }
		.page-footer { grid-template-columns: 1fr 1fr; gap: 12px; }
		.page-footer span:nth-child(2) { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-links a, .credit-row a, .site-header a, .page-footer a { transition: none; }
	}
</style>
