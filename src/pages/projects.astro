---
import '../styles/global.css';

const projects = [
	{ title: 'Ojo de Madera', type: 'Pulsera · 2026', image: '/images/gallery/ojo_madera_04.webp', href: '/projects/ojo-de-madera', real: true },
	{ title: 'Siete Chakras', type: 'Pulsera · 2026', image: '/images/gallery2/siete-chacras_04.webp', href: '/projects/siete-chakras', real: true },
	{ title: 'Piedra Nocturna', type: 'Collar · Estudio', image: '/images/projects/piedra-nocturna.png' },
	{ title: 'Sol de Bronce', type: 'Broche · Estudio', image: '/images/projects/sol-de-bronce.png' },
	{ title: 'Humo y Raíz', type: 'Collar · Estudio', image: '/images/projects/humo-y-raiz.png' },
	{ title: 'Materia I', type: 'Serie · Próximamente', image: '/images/gallery/ojo_madera_05.webp' },
	{ title: 'Materia II', type: 'Serie · Próximamente', image: '/images/gallery/ojo_madera_06.webp' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Catálogo de proyectos y colecciones de Obsidian Art." />
		<title>Proyectos — Obsidian Art</title>
	</head>
	<body class="m-0 bg-[#f2f0eb] font-sans text-[#171714]">
		<main class="flex min-h-svh flex-col px-[clamp(20px,3vw,58px)] pt-6 pb-7 max-[760px]:px-4">
			<header class="grid min-h-[58px] grid-cols-[1fr_auto_1fr] items-center text-[10px] tracking-[.16em] uppercase max-[760px]:grid-cols-[1fr_auto]">
				<a class="font-display text-[15px] font-medium tracking-[.04em] text-inherit no-underline" href="/">Obsidian Art</a>
				<p class="m-0 text-[#6e6b64] max-[760px]:hidden">Archivo de proyectos</p>
				<span class="justify-self-end text-[#8d8981]" aria-hidden="true">01 — 07</span>
			</header>

			<section class="catalog mx-auto mt-[clamp(35px,5vh,70px)] mb-[34px] flex h-[min(61svh,660px)] min-h-[440px] w-full max-w-[1450px] gap-[clamp(7px,.8vw,15px)] max-[760px]:h-[61svh] max-[760px]:min-h-[480px] max-[760px]:gap-2 max-[760px]:overflow-x-auto max-[760px]:snap-x max-[760px]:snap-mandatory" aria-label="Catálogo de proyectos">
				{projects.map((project, index) => (
					<article class:list={['project-card group relative min-w-0 flex-1 overflow-hidden bg-[#d8d5ce] outline-0 transition-[flex-grow,transform,opacity] duration-[650ms] ease-[cubic-bezier(.2,.7,.2,1)] even:translate-y-[5%] [&:nth-child(3n)]:-translate-y-[2%] hover:[flex-grow:2.7] hover:-translate-y-[2%] focus:[flex-grow:2.7] focus:-translate-y-[2%] focus-within:[flex-grow:2.7] focus-within:-translate-y-[2%] max-[760px]:flex-[0_0_46vw] max-[760px]:translate-y-0 max-[760px]:snap-center max-[760px]:even:translate-y-0 max-[760px]:[&:nth-child(3n)]:translate-y-0 max-[760px]:hover:flex-[0_0_46vw] max-[760px]:hover:translate-y-0 max-[760px]:focus:flex-[0_0_46vw] max-[760px]:focus:translate-y-0 max-[760px]:focus-within:flex-[0_0_46vw] max-[760px]:focus-within:translate-y-0', project.real && 'is-current']} tabindex="0">
						<img class="h-full w-full object-cover saturate-[.7] grayscale-[.35] transition-[filter,transform] duration-[800ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.035] group-hover:saturate-100 group-hover:grayscale-0 group-focus:scale-[1.035] group-focus:saturate-100 group-focus:grayscale-0 group-focus-within:scale-[1.035] group-focus-within:saturate-100 group-focus-within:grayscale-0" src={project.image} alt={`Vista previa de ${project.title}`} />
						<div class="absolute inset-0 bg-[rgba(242,240,235,.5)] transition-colors duration-500 group-hover:bg-transparent group-focus:bg-transparent group-focus-within:bg-transparent max-[760px]:bg-[rgba(242,240,235,.18)]"></div>
						<div class="absolute top-3.5 left-3.5 text-[9px] tracking-[.12em] text-white/80">{String(index + 1).padStart(2, '0')}</div>
						<div class="absolute right-0 bottom-0 left-0 z-2 translate-y-3 p-[18px] text-white opacity-0 transition-[opacity,transform] duration-450 before:absolute before:-z-1 before:-top-[70px] before:right-0 before:bottom-0 before:left-0 before:bg-linear-to-b before:from-transparent before:to-black/65 before:content-[''] group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 max-[760px]:translate-y-0 max-[760px]:opacity-100">
							<p class="m-0 text-[9px] tracking-[.13em] uppercase">{project.type}</p>
							<h2 class="my-1.5 font-display text-[clamp(21px,2vw,35px)] leading-[.95] font-normal tracking-[-.045em]">{project.title}</h2>
							<span class="text-[9px] tracking-[.13em] text-white/75 uppercase">{project.real ? 'Ver proyecto →' : 'Proyecto de muestra'}</span>
						</div>
						{project.href && <a class="absolute inset-0 z-3" href={project.href} aria-label={`Ver proyecto ${project.title}`}></a>}
					</article>
				))}
			</section>

			<footer class="mt-auto flex items-end justify-between pt-6 max-[760px]:block">
				<p class="m-0 font-display text-[clamp(24px,3vw,48px)] tracking-[-.045em]"><span class="mb-2 block font-sans text-[9px] tracking-[.16em] text-[#77736b] uppercase">Selección</span> Explora materia, forma y contraste.</p>
				<a class="text-[10px] tracking-[.14em] text-[#5f5c56] uppercase no-underline max-[760px]:mt-6 max-[760px]:inline-block" href="/">Volver a Gallery</a>
			</footer>
		</main>
	</body>
</html>

<style>
	.catalog:has(.project-card:hover) .project-card:not(:hover),.catalog:has(.project-card:focus-within) .project-card:not(:focus-within) { opacity: .62; }
</style>
