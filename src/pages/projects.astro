---
import '../styles/global.css';

const gallery = [
	{
		src: '/images/gallery/ojo_madera_03.webp',
		alt: 'Pulsera Ojo de Madera vista de frente sobre fondo blanco',
	},
	{
		src: '/images/gallery/ojo_madera_05.webp',
		alt: 'Detalle de las cuentas de ojo de tigre y acentos dorados',
	},
	{
		src: '/images/gallery/ojo_madera_01.webp',
		alt: 'Pulsera Ojo de Madera en perspectiva',
	},
	{
		src: '/images/gallery/ojo_madera_04.webp',
		alt: 'Vista cenital de la pulsera Ojo de Madera',
	},
	{
		src: '/images/gallery/ojo_madera_06.webp',
		alt: 'Perfil de las cuentas naturales de la pulsera',
	},
	{
		src: '/images/gallery/ojo_madera_02.webp',
		alt: 'Pulsera Ojo de Madera vista desde un ángulo bajo',
	},
	{
		src: '/images/gallery/ojo_madera_07.webp',
		alt: 'Vista frontal completa de la pulsera Ojo de Madera',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Ojo de Madera — una colección de joyería artesanal en ojo de tigre y detalles dorados."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Ojo de Madera — Obsidian Art</title>
	</head>
	<body>
		<main>
			<header class="hero">
				<h1>OJO DE MADERA</h1>
			</header>

			<section class="lead-gallery" aria-label="Galería Ojo de Madera">
				<figure class="lead-small">
					<img src={gallery[0].src} alt={gallery[0].alt} />
				</figure>
				<figure class="lead-detail">
					<img src={gallery[1].src} alt={gallery[1].alt} />
				</figure>
				<figure class="lead-wide">
					<img src={gallery[2].src} alt={gallery[2].alt} />
				</figure>
			</section>

			<section class="collection" aria-label="Más vistas de Ojo de Madera">
				{gallery.slice(3).map((image, index) => (
					<figure class:list={['collection-item', `item-${index + 1}`]}>
						<img src={image.src} alt={image.alt} loading="lazy" />
					</figure>
				))}
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		background: #f5f4f1;
		color: #24231f;
		font-family: var(--font-sans);
	}

	main {
		overflow: hidden;
	}

	.hero {
		position: relative;
		min-height: clamp(250px, 32vw, 440px);
		padding: clamp(22px, 2.2vw, 40px) clamp(24px, 4vw, 78px) 0;
	}

	.back-link {
		position: relative;
		z-index: 2;
		color: #77746e;
		font-size: 11px;
		letter-spacing: .18em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 180ms ease;
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: #24231f;
	}

	h1 {
		margin: clamp(20px, 2vw, 34px) 0 0;
		color: #cfcecb;
		font-family: var(--font-display);
		font-size: clamp(54px, 11.25vw, 212px);
		font-weight: 500;
		letter-spacing: -.075em;
		line-height: .82;
		text-align: center;
		white-space: nowrap;
	}

	.hero p {
		position: absolute;
		right: 18%;
		bottom: 16%;
		z-index: 1;
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(28px, 4vw, 72px);
		font-style: italic;
		font-weight: 400;
		letter-spacing: -.07em;
		line-height: 1;
		transform: rotate(-6deg);
	}

	.lead-gallery {
		display: grid;
		grid-template-columns: 15.5vw 21vw minmax(0, 1fr);
		align-items: end;
		gap: clamp(14px, 1.25vw, 24px);
		padding: 0 clamp(24px, 3.7vw, 70px) clamp(100px, 11vw, 210px);
	}

	figure {
		margin: 0;
		overflow: hidden;
		background: #ecebe8;
	}

	figure img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms cubic-bezier(.2, .75, .2, 1);
	}

	figure:hover img {
		transform: scale(1.025);
	}

	.lead-small {
		aspect-ratio: .78;
	}

	.lead-detail {
		aspect-ratio: .72;
		margin-left: clamp(35px, 7vw, 132px);
	}

	.lead-detail img {
		object-position: 43% center;
	}

	.lead-wide {
		aspect-ratio: 1.7;
	}

	.collection {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: clamp(18px, 2.6vw, 50px);
		padding: 0 clamp(24px, 5.2vw, 100px) clamp(90px, 10vw, 190px);
	}

	.item-1 {
		grid-column: 2 / span 4;
		aspect-ratio: 1.3;
	}

	.item-2 {
		grid-column: 7 / -1;
		margin-top: 13vw;
		aspect-ratio: 2.15;
	}

	.item-3 {
		grid-column: 1 / span 7;
		margin-top: 4vw;
		aspect-ratio: 1.9;
	}

	.item-4 {
		grid-column: 8 / span 4;
		margin-top: 15vw;
		aspect-ratio: 1.55;
	}

	footer {
		display: flex;
		justify-content: space-between;
		margin: 0 clamp(24px, 4vw, 78px);
		padding: 18px 0 30px;
		border-top: 1px solid #d8d6d1;
		color: #77746e;
		font-size: 10px;
		letter-spacing: .16em;
		text-transform: uppercase;
	}

	@media (max-width: 760px) {
		.hero {
			min-height: 250px;
		}

		h1 {
			margin-top: 46px;
			font-size: clamp(46px, 15vw, 86px);
			line-height: .88;
			white-space: normal;
		}

		.hero p {
			right: 10%;
			bottom: 18px;
		}

		.lead-gallery {
			grid-template-columns: 1fr 1fr;
			align-items: start;
			padding-bottom: 100px;
		}

		.lead-small,
		.lead-detail,
		.lead-wide {
			margin: 0;
		}

		.lead-detail {
			margin-top: 60px;
		}

		.lead-wide {
			grid-column: 1 / -1;
			margin-top: 4px;
		}

		.collection {
			grid-template-columns: 1fr 1fr;
			padding-bottom: 100px;
		}

		.item-1,
		.item-2,
		.item-3,
		.item-4 {
			grid-column: auto;
			margin-top: 0;
		}

		.item-2,
		.item-3 {
			grid-column: 1 / -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		figure img {
			transition: none;
		}
	}
</style>
