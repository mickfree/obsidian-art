---
import '../styles/global.css';

const projects = [
	{ title: 'Ojo de Madera', type: 'Pulsera · 2026', image: '/images/gallery/ojo_madera_04.webp', href: '/projects/ojo-de-madera', real: true },
	{ title: 'Siete Chakras', type: 'Pulsera · 2026', image: '/images/gallery2/siete-chacras_04.webp', href: '/projects/siete-chakras', real: true },
	{ title: 'Piedra Nocturna', type: 'Collar · Estudio', image: '/images/projects/piedra-nocturna.png' },
	{ title: 'Sol de Bronce', type: 'Broche · Estudio', image: '/images/projects/sol-de-bronce.png' },
	{ title: 'Humo y Raíz', type: 'Collar · Estudio', image: '/images/projects/humo-y-raiz.png' },
	{ title: 'Materia I', type: 'Serie · Próximamente', image: '/images/gallery/ojo_madera_05.webp' },
	{ title: 'Materia II', type: 'Serie · Próximamente', image: '/images/gallery/ojo_madera_06.webp' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Catálogo de proyectos y colecciones de Obsidian Art." />
		<title>Proyectos — Obsidian Art</title>
	</head>
	<body>
		<main>
			<header class="site-header">
				<a href="/">Obsidian Art</a>
				<p>Archivo de proyectos</p>
				<span aria-hidden="true">01 — 07</span>
			</header>

			<section class="catalog" aria-label="Catálogo de proyectos">
				{projects.map((project, index) => (
					<article class:list={['project-card', project.real && 'is-current']} tabindex="0">
						<img src={project.image} alt={`Vista previa de ${project.title}`} />
						<div class="veil"></div>
						<div class="number">{String(index + 1).padStart(2, '0')}</div>
						<div class="card-copy">
							<p>{project.type}</p>
							<h2>{project.title}</h2>
							{project.real ? <span>Ver proyecto →</span> : <span>Proyecto de muestra</span>}
						</div>
						{project.href && <a class="card-link" href={project.href} aria-label={`Ver proyecto ${project.title}`}></a>}
					</article>
				))}
			</section>

			<footer>
				<p><span>Selección</span> Explora materia, forma y contraste.</p>
				<a href="/">Volver a Gallery</a>
			</footer>
		</main>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: #f2f0eb; color: #171714; font-family: var(--font-sans); }
	main { display: flex; min-height: 100svh; flex-direction: column; padding: 24px clamp(20px, 3vw, 58px) 28px; }
	.site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 58px; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
	.site-header a { color: inherit; font-family: var(--font-display); font-size: 15px; font-weight: 500; letter-spacing: .04em; text-decoration: none; }
	.site-header p { margin: 0; color: #6e6b64; }
	.site-header span { justify-self: end; color: #8d8981; }
	.catalog { display: flex; height: min(61svh, 660px); min-height: 440px; gap: clamp(7px, .8vw, 15px); margin: clamp(35px, 5vh, 70px) auto 34px; width: min(100%, 1450px); }
	.project-card { position: relative; flex: 1 1 0; min-width: 0; overflow: hidden; background: #d8d5ce; outline: 0; transition: flex-grow 650ms cubic-bezier(.2,.7,.2,1), transform 650ms cubic-bezier(.2,.7,.2,1), opacity 350ms ease; }
	.project-card:nth-child(even) { transform: translateY(5%); }
	.project-card:nth-child(3n) { transform: translateY(-2%); }
	.project-card img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.35) saturate(.7); transition: filter 500ms ease, transform 800ms cubic-bezier(.2,.7,.2,1); }
	.veil { position: absolute; inset: 0; background: rgba(242,240,235,.5); transition: background 450ms ease; }
	.number { position: absolute; top: 14px; left: 14px; color: rgba(255,255,255,.82); font-size: 9px; letter-spacing: .12em; }
	.card-copy { position: absolute; right: 0; bottom: 0; left: 0; z-index: 2; padding: 18px; color: white; opacity: 0; transform: translateY(12px); transition: opacity 350ms ease, transform 450ms ease; }
	.card-copy::before { position: absolute; z-index: -1; inset: -70px 0 0; background: linear-gradient(transparent, rgba(0,0,0,.66)); content: ''; }
	.card-copy p,.card-copy h2 { margin: 0; }
	.card-copy p,.card-copy span { font-size: 9px; letter-spacing: .13em; text-transform: uppercase; }
	.card-copy h2 { margin: 6px 0 10px; font-family: var(--font-display); font-size: clamp(21px, 2vw, 35px); font-weight: 400; letter-spacing: -.045em; line-height: .95; }
	.card-copy span { color: rgba(255,255,255,.75); }
	.card-link { position: absolute; z-index: 3; inset: 0; }
	.project-card:hover,.project-card:focus,.project-card:focus-within { flex-grow: 2.7; transform: translateY(-2%); }
	.project-card:hover img,.project-card:focus img,.project-card:focus-within img { filter: grayscale(0) saturate(1); transform: scale(1.035); }
	.project-card:hover .veil,.project-card:focus .veil,.project-card:focus-within .veil { background: rgba(242,240,235,0); }
	.project-card:hover .card-copy,.project-card:focus .card-copy,.project-card:focus-within .card-copy { opacity: 1; transform: translateY(0); }
	.catalog:has(.project-card:hover) .project-card:not(:hover),.catalog:has(.project-card:focus-within) .project-card:not(:focus-within) { opacity: .62; }
	footer { display: flex; align-items: end; justify-content: space-between; margin-top: auto; padding-top: 26px; }
	footer p { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 3vw, 48px); letter-spacing: -.045em; }
	footer p span { display: block; margin-bottom: 8px; color: #77736b; font-family: var(--font-sans); font-size: 9px; letter-spacing: .16em; text-transform: uppercase; }
	footer a { color: #5f5c56; font-size: 10px; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; }
	@media (max-width: 760px) {
		main { padding-inline: 16px; }
		.site-header { grid-template-columns: 1fr auto; }
		.site-header p { display: none; }
		.catalog { height: 61svh; min-height: 480px; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; }
		.project-card,.project-card:hover,.project-card:focus,.project-card:focus-within { flex: 0 0 46vw; transform: none; scroll-snap-align: center; }
		.project-card:nth-child(even),.project-card:nth-child(3n) { transform: none; }
		.veil { background: rgba(242,240,235,.18); }
		.card-copy { opacity: 1; transform: none; }
		footer { display: block; }
		footer a { display: inline-block; margin-top: 26px; }
	}
	@media (prefers-reduced-motion: reduce) { .project-card,.project-card img,.veil,.card-copy { transition: none; } }
</style>
